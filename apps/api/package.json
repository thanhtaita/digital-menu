{
  "name": "@digital-menu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm --filter @digital-menu/db build && pnpm --filter @digital-menu/shared build",
    "dev": "cross-env PORT=3002 tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill:fdc": "tsx src/scripts/backfill-fdc-nutrients.ts",
    "backfill:diet-tags": "tsx src/scripts/backfill-diet-tags.ts"
  },
  "dependencies": {
    "@digital-menu/db": "workspace:*",
    "@digital-menu/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.0.0",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.0.0",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
